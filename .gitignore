# Secrets: never commit a real env file. `*.env` covers any .env-style file
# anywhere (including generated ones under artifacts/, e.g. a local agent's
# AGENT_API_KEY or a navigation token); it does not match *.env.example, so the
# tracked templates stay in the repository.
*.env
/local.env
.env.local
vendor/

# WebGL frontend build dependencies
web/node_modules/
# Playwright MCP session artifacts
.playwright-mcp/

# Generated runs, raw sensor evidence, caches and local release backups stay local.
# Existing curated tracked artifacts remain tracked; new exceptions require review.
/artifacts/*
!/artifacts/marketing/
