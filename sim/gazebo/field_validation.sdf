    <model name="ground-a">
      <pose>-2.0 -1.0 0.16 0 0 0</pose>
      <link name="base_link">
        <inertial>
          <mass>12</mass>
          <inertia>
            <ixx>.3</ixx>
            <iyy>.4</iyy>
            <izz>.5</izz>
            <ixy>0</ixy>
            <ixz>0</ixz>
            <iyz>0</iyz>
          </inertia>
        </inertial>
        <collision name="body_collision">
          <geometry>
            <box>
              <size>.5 .4 .3</size>
            </box>
          </geometry>
          <surface>
            <friction>
              <ode>
                <mu>0.015</mu>
                <mu2>0.015</mu2>
              </ode>
            </friction>
          </surface>
        </collision>
        <visual name="body_visual">
          <geometry>
            <box>
              <size>.5 .4 .3</size>
            </box>
          </geometry>
          <material>
            <diffuse>.2 .5 .8 1</diffuse>
          </material>
        </visual>
        <sensor name="lidar" type="gpu_lidar">
          <pose>0.12 0.04 0.2 0.02 -0.08 0.12</pose>
          <topic>/field/ground-a/lidar</topic>
          <update_rate>10</update_rate>
          <always_on>true</always_on>
          <lidar>
            <scan>
              <horizontal>
                <samples>360</samples>
                <resolution>1</resolution>
                <min_angle>-3.141592653589793</min_angle>
                <max_angle>3.141592653589793</max_angle>
              </horizontal>
              <vertical>
                <samples>17</samples>
                <resolution>1</resolution>
                <min_angle>-.4</min_angle>
                <max_angle>.6</max_angle>
              </vertical>
            </scan>
            <range>
              <min>.05</min>
              <max>15</max>
              <resolution>.001</resolution>
            </range>
          </lidar>
        </sensor>
        <sensor name="imu" type="imu">
          <topic>/field/ground-a/imu</topic>
          <update_rate>100</update_rate>
          <always_on>true</always_on>
        </sensor>
        <sensor name="contact" type="contact">
          <topic>/field/ground-a/contacts</topic>
          <always_on>true</always_on>
          <update_rate>100</update_rate>
          <contact>
            <collision>body_collision</collision>
          </contact>
        </sensor>
      </link>
      <plugin filename="libtangying_field_controller.so" name="tangying::FieldController">
        <aerial>false</aerial>
        <mass>12</mass>
        <lease_seconds>.4</lease_seconds>
      </plugin>
    </model>
