                  "type": "object"
                },
                "aliases": {
                  "maxItems": 16.0,
                  "type": "array",
                  "items": {
                    "minLength": 1.0,
                    "type": "string",
                    "maxLength": 128.0
                  }
                },
                "bounds": {
                  "properties": {
                    "min": {
                      "maxItems": 3.0,
                      "minItems": 3.0,
                      "type": "array",
                      "items": {
                        "type": "number"
                      }
                    },
                    "max": {
                      "maxItems": 3.0,
                      "minItems": 3.0,
                      "type": "array",
                      "items": {
                        "type": "number"
                      }
                    }
                  },
                  "required": [
                    "min",
                    "max"
                  ],
                  "additionalProperties": false,
                  "type": "object"
                }
              },
              "required": [
                "id",
                "name",
                "category",
                "kind",
                "bounds",
                "source",
                "confidence",
                "observedAtUnixMs"
              ],
