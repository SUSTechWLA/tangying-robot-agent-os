    "navigation.y": {
      "min": -2.0,
      "max": 2.0,
      "unit": "m"
    },
    "navigation.z": {
      "min": 0.0,
      "max": 0.0,
      "unit": "m"
    }
  },
  "tools": [
    "observe_scene",
    "navigation.navigate",
    "verify_arrival",
    "emergency_stop"
  ],
  "mobility": {
    "schemaVersion": "robot.mobility.v1",
    "domain": "ground",
    "motionModel": "legged",
    "poseModel": "se3",
    "commandFrame": "world",
    "worldConvention": "right_handed_z_up",
    "linearUnit": "m",
    "angularUnit": "rad",
    "maxLinearSpeedMps": 0.2,
    "maxAngularSpeedRadps": 0.4,
    "safeStop": {
      "strategy": "hold_position",
      "procedureId": "commissioning-legged-stop-v1",
      "controllerOwned": true,
      "commandLossTimeoutMs": 500
    },
    "navigationPreparation": "controller"
  }
