{
  "schemaVersion": "robot.profile.v1",
  "robotId": "commissioning-legged",
  "adapterId": "commissioned_ros2_legged",
  "adapterVersion": "1.0.0",
  "modelId": "replace-with-hardware-model",
  "embodiment": "legged",
  "joints": [],
  "endEffectors": [],
  "sensors": [
    {
      "sourceId": "commissioning-legged/localization",
      "sourceType": "sensor_fusion",
