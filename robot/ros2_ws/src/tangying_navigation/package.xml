<?xml version="1.0"?>
<package format="3">
  <name>tangying_navigation</name><version>0.1.0</version>
  <description>RGB-D observation bridge, RTAB-Map and Nav2 for Tangying.</description>
  <maintainer email="opensource@sustechwla.org">SUSTechWLA</maintainer><license>Apache-2.0</license>
  <buildtool_depend>ament_python</buildtool_depend>
  <exec_depend>rclpy</exec_depend><exec_depend>launch</exec_depend><exec_depend>launch_ros</exec_depend>
  <exec_depend>sensor_msgs</exec_depend><exec_depend>nav_msgs</exec_depend><exec_depend>geometry_msgs</exec_depend>
  <exec_depend>rtabmap_msgs</exec_depend><exec_depend>nav2_msgs</exec_depend><exec_depend>action_msgs</exec_depend><exec_depend>tf2_ros_py</exec_depend>
  <exec_depend>tf2_geometry_msgs</exec_depend><exec_depend>sensor_msgs_py</exec_depend>
  <exec_depend>python3-numpy</exec_depend><exec_depend>python3-yaml</exec_depend><exec_depend>rtabmap_slam</exec_depend>
  <exec_depend>nav2_controller</exec_depend><exec_depend>nav2_planner</exec_depend>
  <exec_depend>nav2_bt_navigator</exec_depend><exec_depend>nav2_lifecycle_manager</exec_depend>
  <test_depend>python3-pytest</test_depend>
  <export><build_type>ament_python</build_type></export>
</package>
