<?xml version="1.0"?>
<!--
  Tangying Gazebo Harmonic home.  This is an intentionally modest, redistributable
  four-room world for integration and acceptance tests.  The navigation stack only
  receives RGB-D, CameraInfo, PointCloud2, TF and wheel odometry through ros_gz;
  no room labels or ground-truth pose are bridged into ROS.
-->
<sdf version="1.9">
  <world name="tangying_home">
    <physics name="default_physics" type="ignored">
      <max_step_size>0.004</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>
    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>
    <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>

    <light type="directional" name="sun">
      <pose>0 0 8 0.3 0.2 -0.4</pose>
      <cast_shadows>true</cast_shadows>
      <diffuse>0.85 0.85 0.85 1</diffuse>
      <specular>0.25 0.25 0.25 1</specular>
      <direction>-0.3 0.2 -1.0</direction>
    </light>

    <model name="floor"><static>true</static>
      <link name="link">
        <collision name="collision"><geometry><box><size>12 10 0.1</size></box></geometry></collision>
        <visual name="visual">
          <geometry><box><size>12 10 0.1</size></box></geometry>
          <material><ambient>0.55 0.57 0.60 1</ambient><diffuse>0.55 0.57 0.60 1</diffuse></material>
        </visual>
      </link>
      <pose>0 2 -0.05 0 0 0</pose>
    </model>

    <!-- outer walls: x in [-6,6], y in [-3,7] -->
    <model name="outer_wall_west"><static>true</static><link name="link"><collision name="c"><geometry><box><size>0.12 10 2.6</size></box></geometry></collision><visual name="v"><geometry><box><size>0.12 10 2.6</size></box></geometry><material><ambient>0.72 0.74 0.78 1</ambient><diffuse>0.72 0.74 0.78 1</diffuse></material></visual></link><pose>-6 2 1.3 0 0 0</pose></model>
    <model name="outer_wall_east"><static>true</static><link name="link"><collision name="c"><geometry><box><size>0.12 10 2.6</size></box></geometry></collision><visual name="v"><geometry><box><size>0.12 10 2.6</size></box></geometry><material><ambient>0.72 0.74 0.78 1</ambient><diffuse>0.72 0.74 0.78 1</diffuse></material></visual></link><pose>6 2 1.3 0 0 0</pose></model>
    <model name="outer_wall_south"><static>true</static><link name="link"><collision name="c"><geometry><box><size>12 0.12 2.6</size></box></geometry></collision><visual name="v"><geometry><box><size>12 0.12 2.6</size></box></geometry><material><ambient>0.72 0.74 0.78 1</ambient><diffuse>0.72 0.74 0.78 1</diffuse></material></visual></link><pose>0 -3 1.3 0 0 0</pose></model>
    <model name="outer_wall_north"><static>true</static><link name="link"><collision name="c"><geometry><box><size>12 0.12 2.6</size></box></geometry></collision><visual name="v"><geometry><box><size>12 0.12 2.6</size></box></geometry><material><ambient>0.72 0.74 0.78 1</ambient><diffuse>0.72 0.74 0.78 1</diffuse></material></visual></link><pose>0 7 1.3 0 0 0</pose></model>

    <!-- Internal partitions leave 1.2 m doors and a 3 m central corridor. -->
    <model name="partition_lower_west"><static>true</static><link name="link"><collision name="c"><geometry><box><size>0.12 2.3 2.6</size></box></geometry></collision><visual name="v"><geometry><box><size>0.12 2.3 2.6</size></box></geometry><material><ambient>0.70 0.72 0.76 1</ambient><diffuse>0.70 0.72 0.76 1</diffuse></material></visual></link><pose>0 -1.85 1.3 0 0 0</pose></model>
    <model name="partition_lower_east"><static>true</static><link name="link"><collision name="c"><geometry><box><size>0.12 0.8 2.6</size></box></geometry></collision><visual name="v"><geometry><box><size>0.12 0.8 2.6</size></box></geometry><material><ambient>0.70 0.72 0.76 1</ambient><diffuse>0.70 0.72 0.76 1</diffuse></material></visual></link><pose>0 1.6 1.3 0 0 0</pose></model>
    <model name="partition_upper_west"><static>true</static><link name="link"><collision name="c"><geometry><box><size>0.12 1.8 2.6</size></box></geometry></collision><visual name="v"><geometry><box><size>0.12 1.8 2.6</size></box></geometry><material><ambient>0.70 0.72 0.76 1</ambient><diffuse>0.70 0.72 0.76 1</diffuse></material></visual></link><pose>0 2.9 1.3 0 0 0</pose></model>
    <model name="partition_upper_east"><static>true</static><link name="link"><collision name="c"><geometry><box><size>0.12 1.8 2.6</size></box></geometry></collision><visual name="v"><geometry><box><size>0.12 1.8 2.6</size></box></geometry><material><ambient>0.70 0.72 0.76 1</ambient><diffuse>0.70 0.72 0.76 1</diffuse></material></visual></link><pose>0 6.1 1.3 0 0 0</pose></model>
    <model name="partition_mid_west"><static>true</static><link name="link"><collision name="c"><geometry><box><size>4.5 0.12 2.6</size></box></geometry></collision><visual name="v"><geometry><box><size>4.5 0.12 2.6</size></box></geometry><material><ambient>0.68 0.70 0.74 1</ambient><diffuse>0.68 0.70 0.74 1</diffuse></material></visual></link><pose>-3.75 2 1.3 0 0 0</pose></model>
    <model name="partition_mid_east"><static>true</static><link name="link"><collision name="c"><geometry><box><size>4.5 0.12 2.6</size></box></geometry></collision><visual name="v"><geometry><box><size>4.5 0.12 2.6</size></box></geometry><material><ambient>0.68 0.70 0.74 1</ambient><diffuse>0.68 0.70 0.74 1</diffuse></material></visual></link><pose>3.75 2 1.3 0 0 0</pose></model>

    <!-- High-contrast wall details keep RGB-D visual odometry observable at
         startup. They are real geometry in the camera view, never semantic
         room labels or simulator state exposed to the ROS boundary. -->
    <model name="living_wall_panel_1"><static>true</static><link name="link"><visual name="frame"><geometry><box><size>0.035 0.48 0.72</size></box></geometry><material><ambient>0.08 0.10 0.14 1</ambient><diffuse>0.08 0.10 0.14 1</diffuse></material></visual><visual name="inset"><pose>-0.02 0 0 0 0 0</pose><geometry><box><size>0.02 0.34 0.56</size></box></geometry><material><ambient>0.86 0.56 0.18 1</ambient><diffuse>0.86 0.56 0.18 1</diffuse></material></visual></link><pose>-0.08 -2.35 1.45 0 0 0</pose></model>
    <model name="living_wall_panel_2"><static>true</static><link name="link"><visual name="frame"><geometry><box><size>0.035 0.48 0.72</size></box></geometry><material><ambient>0.08 0.10 0.14 1</ambient><diffuse>0.08 0.10 0.14 1</diffuse></material></visual><visual name="inset"><pose>-0.02 0 0 0 0 0</pose><geometry><box><size>0.02 0.34 0.56</size></box></geometry><material><ambient>0.18 0.62 0.70 1</ambient><diffuse>0.18 0.62 0.70 1</diffuse></material></visual></link><pose>-0.08 -1.65 1.45 0 0 0</pose></model>
    <model name="living_wall_panel_3"><static>true</static><link name="link"><visual name="frame"><geometry><box><size>0.035 0.48 0.72</size></box></geometry><material><ambient>0.08 0.10 0.14 1</ambient><diffuse>0.08 0.10 0.14 1</diffuse></material></visual><visual name="inset"><pose>-0.02 0 0 0 0 0</pose><geometry><box><size>0.02 0.34 0.56</size></box></geometry><material><ambient>0.56 0.30 0.62 1</ambient><diffuse>0.56 0.30 0.62 1</diffuse></material></visual></link><pose>-0.08 -0.95 1.45 0 0 0</pose></model>

    <!-- Low-poly furniture creates visual features and realistic obstacles. -->
    <model name="living_sofa"><static>true</static><link name="link"><collision name="c"><geometry><box><size>2.0 0.65 0.65</size></box></geometry></collision><visual name="v"><geometry><box><size>2.0 0.65 0.65</size></box></geometry><material><ambient>0.20 0.38 0.62 1</ambient><diffuse>0.20 0.38 0.62 1</diffuse></material></visual></link><pose>-4.6 -1.9 0.325 0 0 0</pose></model>
    <model name="living_table"><static>true</static><link name="link"><collision name="c"><geometry><box><size>1.2 0.75 0.5</size></box></geometry></collision><visual name="v"><geometry><box><size>1.2 0.75 0.5</size></box></geometry><material><ambient>0.60 0.35 0.16 1</ambient><diffuse>0.60 0.35 0.16 1</diffuse></material></visual></link><pose>-3.4 -0.4 0.25 0 0 0</pose></model>
    <model name="kitchen_island"><static>true</static><link name="link"><collision name="c"><geometry><box><size>2.1 0.8 0.95</size></box></geometry></collision><visual name="v"><geometry><box><size>2.1 0.8 0.95</size></box></geometry><material><ambient>0.82 0.54 0.20 1</ambient><diffuse>0.82 0.54 0.20 1</diffuse></material></visual></link><pose>3.6 -0.8 0.475 0 0 0</pose></model>
    <model name="kitchen_counter"><static>true</static><link name="link"><collision name="c"><geometry><box><size>3.3 0.55 0.9</size></box></geometry></collision><visual name="v"><geometry><box><size>3.3 0.55 0.9</size></box></geometry><material><ambient>0.38 0.48 0.42 1</ambient><diffuse>0.38 0.48 0.42 1</diffuse></material></visual></link><pose>4.1 -2.35 0.45 0 0 0</pose></model>
    <model name="bed"><static>true</static><link name="link"><collision name="c"><geometry><box><size>2.8 1.8 0.48</size></box></geometry></collision><visual name="v"><geometry><box><size>2.8 1.8 0.48</size></box></geometry><material><ambient>0.56 0.36 0.56 1</ambient><diffuse>0.56 0.36 0.56 1</diffuse></material></visual></link><pose>-4.0 5.3 0.24 0 0 0</pose></model>
    <model name="bedside_table"><static>true</static><link name="link"><collision name="c"><geometry><box><size>0.65 0.65 0.65</size></box></geometry></collision><visual name="v"><geometry><box><size>0.65 0.65 0.65</size></box></geometry><material><ambient>0.35 0.22 0.14 1</ambient><diffuse>0.35 0.22 0.14 1</diffuse></material></visual></link><pose>-1.7 5.9 0.325 0 0 0</pose></model>
    <model name="bathroom_sink"><static>true</static><link name="link"><collision name="c"><geometry><box><size>1.4 0.65 0.9</size></box></geometry></collision><visual name="v"><geometry><box><size>1.4 0.65 0.9</size></box></geometry><material><ambient>0.32 0.62 0.70 1</ambient><diffuse>0.32 0.62 0.70 1</diffuse></material></visual></link><pose>3.6 5.8 0.45 0 0 0</pose></model>
    <model name="bathroom_bench"><static>true</static><link name="link"><collision name="c"><geometry><box><size>1.0 0.55 0.55</size></box></geometry></collision><visual name="v"><geometry><box><size>1.0 0.55 0.55</size></box></geometry><material><ambient>0.75 0.75 0.78 1</ambient><diffuse>0.75 0.75 0.78 1</diffuse></material></visual></link><pose>4.9 3.4 0.275 0 0 0</pose></model>

    <model name="tangying_robot">
      <pose>-4.7 -0.8 0.16 0 0 0</pose>
      <link name="base_link">
        <inertial><mass>18</mass><inertia><ixx>0.7</ixx><iyy>0.7</iyy><izz>0.9</izz><ixy>0</ixy><ixz>0</ixz><iyz>0</iyz></inertia></inertial>
        <collision name="collision"><geometry><box><size>0.65 0.55 0.32</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>0.65 0.55 0.32</size></box></geometry><material><ambient>0.15 0.18 0.22 1</ambient><diffuse>0.15 0.18 0.22 1</diffuse></material></visual>
        <sensor name="base_rgbd" type="rgbd_camera">
          <!-- The mapping camera, and it has to be the reference robot's mapping
               camera or the SLAM is solving a different problem. That camera sits
               low and looks 15 degrees down so it can see the *floor*; this one
               used to sit at 0.48 m looking level, which measures walls. Measured
               consequence: no frame ever registered, because a level camera in a
               room gives ICP two far, repetitive surfaces and no ground plane -
               28 frames, 0 registrations, and the map publisher refusing the leg.
               x is 0.36 rather than the reference 0.30 only to clear this world's
               0.65 m chassis, which would otherwise occlude the lens. -->
          <pose>0.36 0 0.16 0 0.261799 0</pose>
          <camera><horizontal_fov>1.25</horizontal_fov><image><width>320</width><height>240</height><format>R8G8B8</format></image><clip><near>0.08</near><far>5.0</far></clip></camera>
          <always_on>true</always_on><update_rate>15</update_rate><visualize>false</visualize>
          <topic>/camera/base</topic><gz_frame_id>base_camera_optical_frame</gz_frame_id>
        </sensor>
        <sensor name="head_rgbd" type="rgbd_camera">
          <pose>0.05 0 1.05 0 0 0</pose>
          <camera><horizontal_fov>1.25</horizontal_fov><image><width>320</width><height>240</height><format>R8G8B8</format></image><clip><near>0.08</near><far>5.0</far></clip></camera>
          <always_on>true</always_on><update_rate>15</update_rate><visualize>false</visualize>
          <topic>/camera/head</topic><gz_frame_id>head_camera_optical_frame</gz_frame_id>
        </sensor>
      </link>
      <link name="left_wheel"><pose>0 0.31 -0.09 1.5708 0 0</pose><inertial><mass>1</mass><inertia><ixx>0.02</ixx><iyy>0.02</iyy><izz>0.02</izz><ixy>0</ixy><ixz>0</ixz><iyz>0</iyz></inertia></inertial><collision name="c"><geometry><cylinder><radius>0.11</radius><length>0.05</length></cylinder></geometry></collision><visual name="v"><geometry><cylinder><radius>0.11</radius><length>0.05</length></cylinder></geometry><material><ambient>0.05 0.05 0.06 1</ambient><diffuse>0.05 0.05 0.06 1</diffuse></material></visual></link>
      <link name="right_wheel"><pose>0 -0.31 -0.09 1.5708 0 0</pose><inertial><mass>1</mass><inertia><ixx>0.02</ixx><iyy>0.02</iyy><izz>0.02</izz><ixy>0</ixy><ixz>0</ixz><iyz>0</iyz></inertia></inertial><collision name="c"><geometry><cylinder><radius>0.11</radius><length>0.05</length></cylinder></geometry></collision><visual name="v"><geometry><cylinder><radius>0.11</radius><length>0.05</length></cylinder></geometry><material><ambient>0.05 0.05 0.06 1</ambient><diffuse>0.05 0.05 0.06 1</diffuse></material></visual></link>
      <link name="caster"><pose>-0.24 0 -0.10 0 0 0</pose><inertial><mass>0.3</mass><inertia><ixx>0.01</ixx><iyy>0.01</iyy><izz>0.01</izz><ixy>0</ixy><ixz>0</ixz><iyz>0</iyz></inertia></inertial><collision name="c"><geometry><sphere><radius>0.09</radius></sphere></geometry></collision><visual name="v"><geometry><sphere><radius>0.09</radius></sphere></geometry><material><ambient>0.12 0.12 0.13 1</ambient><diffuse>0.12 0.12 0.13 1</diffuse></material></visual></link>
      <joint name="left_wheel_joint" type="revolute"><parent>base_link</parent><child>left_wheel</child><axis><xyz expressed_in="__model__">0 1 0</xyz></axis></joint>
      <joint name="right_wheel_joint" type="revolute"><parent>base_link</parent><child>right_wheel</child><axis><xyz expressed_in="__model__">0 1 0</xyz></axis></joint>
      <joint name="caster_joint" type="ball"><parent>base_link</parent><child>caster</child></joint>
      <plugin filename="gz-sim-diff-drive-system" name="gz::sim::systems::DiffDrive">
        <left_joint>left_wheel_joint</left_joint><right_joint>right_wheel_joint</right_joint>
        <wheel_separation>0.62</wheel_separation><wheel_radius>0.11</wheel_radius>
        <odom_topic>/odom</odom_topic><topic>/cmd_vel</topic><frame_id>odom</frame_id><child_frame_id>base_link</child_frame_id>
        <odom_publish_frequency>30</odom_publish_frequency><publish_tf>true</publish_tf>
        <max_linear_velocity>0.35</max_linear_velocity><min_linear_velocity>-0.35</min_linear_velocity>
        <max_angular_velocity>0.8</max_angular_velocity><min_angular_velocity>-0.8</min_angular_velocity>
      </plugin>
      <!-- BEGIN generated arms: scripts/generate_gazebo_arm.py -->
            <!-- Generated from arm_kinematics.json. Edit the table, not this.
                 Geometry is simplified on purpose; joint axes, limits and motor
                 names are the table's, so both simulators describe one robot. -->
            <link name="left_arm_link1">
              <pose relative_to="base_link">0.1352 -0.15 0.7865 1.5708 -8.00005e-12 1.5708</pose>
              <inertial><mass>0.26</mass><inertia><ixx>2.6e-05</ixx><iyy>2.6e-05</iyy><izz>2.6e-05</izz><ixy>0</ixy><ixz>0</ixz><iyz>0</iyz></inertia></inertial>
              <collision name="c"><geometry><cylinder><radius>0.022</radius><length>0.10697</length></cylinder></geometry></collision>
              <visual name="v"><geometry><cylinder><radius>0.022</radius><length>0.10697</length></cylinder></geometry><material><ambient>0.84 0.62 0.24 1</ambient><diffuse>0.84 0.62 0.24 1</diffuse></material></visual>
            </link>
            <joint name="left_arm_shoulder_pan" type="revolute">
              <parent>base_link</parent><child>left_arm_link1</child>
              <axis><xyz>0 -1 0</xyz><limit><lower>-2.1</lower><upper>2.1</upper><effort>20</effort><velocity>3.0</velocity></limit><dynamics><damping>0.6</damping></dynamics></axis>
            </joint>
            <link name="left_arm_link2">
              <pose relative_to="left_arm_link1">0 0.1025 0.0306 1.5708 0 0</pose>
              <inertial><mass>0.26</mass><inertia><ixx>2.6e-05</ixx><iyy>2.6e-05</iyy><izz>2.6e-05</izz><ixy>0</ixy><ixz>0</ixz><iyz>0</iyz></inertia></inertial>
              <collision name="c"><geometry><cylinder><radius>0.022</radius><length>0.116</length></cylinder></geometry></collision>
              <visual name="v"><geometry><cylinder><radius>0.022</radius><length>0.116</length></cylinder></geometry><material><ambient>0.84 0.62 0.24 1</ambient><diffuse>0.84 0.62 0.24 1</diffuse></material></visual>
            </link>
            <joint name="left_arm_shoulder_lift" type="revolute">
              <parent>left_arm_link1</parent><child>left_arm_link2</child>
              <axis><xyz>-1 0 0</xyz><limit><lower>-0.1</lower><upper>3.45</upper><effort>20</effort><velocity>3.0</velocity></limit><dynamics><damping>0.6</damping></dynamics></axis>
            </joint>
            <link name="left_arm_link3">
              <pose relative_to="left_arm_link2">0 0.11257 0.028 -1.5708 0 0</pose>
              <inertial><mass>0.26</mass><inertia><ixx>2.6e-05</ixx><iyy>2.6e-05</iyy><izz>2.6e-05</izz><ixy>0</ixy><ixz>0</ixz><iyz>0</iyz></inertia></inertial>
              <collision name="c"><geometry><cylinder><radius>0.022</radius><length>0.135</length></cylinder></geometry></collision>
              <visual name="v"><geometry><cylinder><radius>0.022</radius><length>0.135</length></cylinder></geometry><material><ambient>0.84 0.62 0.24 1</ambient><diffuse>0.84 0.62 0.24 1</diffuse></material></visual>
            </link>
            <joint name="left_arm_elbow_flex" type="revolute">
              <parent>left_arm_link2</parent><child>left_arm_link3</child>
              <axis><xyz>1 0 0</xyz><limit><lower>-0.2</lower><upper>3.14159</upper><effort>20</effort><velocity>3.0</velocity></limit><dynamics><damping>0.6</damping></dynamics></axis>
            </joint>
            <link name="left_arm_link4">
              <pose relative_to="left_arm_link3">0 0.0052 0.1349 -1.5708 0 0</pose>
              <inertial><mass>0.26</mass><inertia><ixx>2.6e-05</ixx><iyy>2.6e-05</iyy><izz>2.6e-05</izz><ixy>0</ixy><ixz>0</ixz><iyz>0</iyz></inertia></inertial>
              <collision name="c"><geometry><cylinder><radius>0.022</radius><length>0.0601</length></cylinder></geometry></collision>
              <visual name="v"><geometry><cylinder><radius>0.022</radius><length>0.0601</length></cylinder></geometry><material><ambient>0.84 0.62 0.24 1</ambient><diffuse>0.84 0.62 0.24 1</diffuse></material></visual>
            </link>
            <joint name="left_arm_wrist_flex" type="revolute">
              <parent>left_arm_link3</parent><child>left_arm_link4</child>
              <axis><xyz>1 0 0</xyz><limit><lower>-1.8</lower><upper>1.8</upper><effort>20</effort><velocity>3.0</velocity></limit><dynamics><damping>0.6</damping></dynamics></axis>
            </joint>
            <link name="left_arm_link5">
              <pose relative_to="left_arm_link4">0 -0.0601 0 3.14159 1.57079 3.14159</pose>
              <inertial><mass>0.26</mass><inertia><ixx>2.6e-05</ixx><iyy>2.6e-05</iyy><izz>2.6e-05</izz><ixy>0</ixy><ixz>0</ixz><iyz>0</iyz></inertia></inertial>
              <collision name="c"><geometry><cylinder><radius>0.022</radius><length>0.0316765</length></cylinder></geometry></collision>
              <visual name="v"><geometry><cylinder><radius>0.022</radius><length>0.0316765</length></cylinder></geometry><material><ambient>0.84 0.62 0.24 1</ambient><diffuse>0.84 0.62 0.24 1</diffuse></material></visual>
            </link>
            <joint name="left_arm_wrist_roll" type="revolute">
              <parent>left_arm_link4</parent><child>left_arm_link5</child>
              <axis><xyz>0 -1 0</xyz><limit><lower>-3.14159</lower><upper>3.14159</upper><effort>20</effort><velocity>3.0</velocity></limit><dynamics><damping>0.6</damping></dynamics></axis>
            </joint>
            <link name="left_arm_link6">
              <pose relative_to="left_arm_link5">-0.0202 -0.0244 0 -3.14159 -2.492e-14 -2.95319</pose>
              <inertial><mass>0.08</mass><inertia><ixx>8e-06</ixx><iyy>8e-06</iyy><izz>8e-06</izz><ixy>0</ixy><ixz>0</ixz><iyz>0</iyz></inertia></inertial>
              <collision name="c"><geometry><box><size>0.032 0.04 0.012</size></box></geometry><surface><friction><ode><mu>1.2</mu><mu2>1.2</mu2></ode></friction></surface></collision>
              <visual name="v"><geometry><box><size>0.032 0.04 0.012</size></box></geometry><material><ambient>0.84 0.62 0.24 1</ambient><diffuse>0.84 0.62 0.24 1</diffuse></material></visual>
            </link>
            <joint name="left_arm_gripper" type="revolute">
              <parent>left_arm_link5</parent><child>left_arm_link6</child>
              <axis><xyz>0 0 1</xyz><limit><lower>-3.14159</lower><upper>3.14159</upper><effort>40</effort><velocity>3.0</velocity></limit><dynamics><damping>2.0</damping></dynamics></axis>
            </joint>
            <link name="right_arm_link1">
              <pose relative_to="base_link">0.1352 0.15 0.7865 1.5708 -8.00005e-12 1.5708</pose>
              <inertial><mass>0.26</mass><inertia><ixx>2.6e-05</ixx><iyy>2.6e-05</iyy><izz>2.6e-05</izz><ixy>0</ixy><ixz>0</ixz><iyz>0</iyz></inertia></inertial>
