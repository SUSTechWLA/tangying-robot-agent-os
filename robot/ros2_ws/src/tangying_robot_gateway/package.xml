<?xml version="1.0"?>
<package format="3">
  <name>tangying_ros_gateway</name>
  <version>0.1.0</version>
  <description>Bridges the Tangying product gateway to local ROS 2 actions and observations.</description>
  <maintainer email="opensource@sustechwla.org">SUSTechWLA</maintainer>
  <license>Apache-2.0</license>
  <buildtool_depend>ament_python</buildtool_depend>
  <exec_depend>rclpy</exec_depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>std_msgs</exec_depend>
  <exec_depend>tangying_robot_msgs</exec_depend>
  <exec_depend>tangying_safety_supervisor</exec_depend>
  <export><build_type>ament_python</build_type></export>
</package>
