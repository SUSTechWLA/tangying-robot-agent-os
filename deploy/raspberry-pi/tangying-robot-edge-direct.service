[Unit]
Description=Tangying Robot Edge direct gateway (ROS2-free)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=tangying-robot
Group=tangying-robot
SupplementaryGroups=dialout
EnvironmentFile=/etc/tangying-robot-agent-os/robot-pi.env
Environment=PYTHONUNBUFFERED=1
Environment=PYTHONPATH=/opt/tangying-robot-agent-os/python:/opt/tangying-robot-agent-os/robot/gateway:/opt/tangying-robot-agent-os/robot/ros2_ws/src/xlerobot_adapter:/opt/tangying-robot-agent-os/.venv/lib/python3.12/site-packages
WorkingDirectory=/opt/tangying-robot-agent-os
ExecStart=/opt/tangying-robot-agent-os/.venv/bin/python -m tangying_robot_gateway.run_direct_edge --listen ${ROBOT_GRPC_LISTEN} --entity-provider ${ROBOT_ENTITY_PROVIDER} --policy-provider ${ROBOT_POLICY_PROVIDER} --verifier-provider ${ROBOT_VERIFIER_PROVIDER} --server-key ${ROBOT_SERVER_KEY} --server-cert ${ROBOT_SERVER_CERT} --client-ca ${ROBOT_CLIENT_CA}
Restart=on-failure
RestartSec=1
TimeoutStopSec=10
KillSignal=SIGINT
UMask=0027
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/var/lib/tangying-robot-agent-os /dev

[Install]
WantedBy=multi-user.target
