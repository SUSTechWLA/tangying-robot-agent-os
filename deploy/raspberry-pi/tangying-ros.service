[Unit]
Description=Tangying XLeRobot ROS 2 stack
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=tangying-robot
Environment=ROS_DOMAIN_ID=73
Environment=ROS_AUTOMATIC_DISCOVERY_RANGE=LOCALHOST
ExecStart=/bin/bash -lc 'source /opt/ros/jazzy/setup.bash && source /opt/tangying-robot-agent/robot/ros2_ws/install/setup.bash && ros2 run xlerobot_adapter adapter --ros-args --params-file /opt/tangying-robot-agent/robot/ros2_ws/src/xlerobot_adapter/config/xlerobot.yaml'
Restart=on-failure
RestartSec=2

[Install]
WantedBy=multi-user.target
