LOCAL_LISTEN=127.0.0.1:8787
ROBOT_ADDRESS=xlerobot.local:50051
ROBOT_SERVER_NAME=xlerobot.local
ROBOT_CA=
ROBOT_CERT=
ROBOT_KEY=
AGENT_PROVIDER=deterministic
AGENT_BASE_URL=
AGENT_API_KEY=
AGENT_MODEL=
AGENT_ORCHESTRATION_SAMPLES=1

# Optional single-robot identity and independent model stages. A local
# OpenAI-compatible quantized server can omit API_KEY.
LOCAL_ROBOT_ID=robot-local
# AGENT_INTENT_PROVIDER=openai
# AGENT_INTENT_BASE_URL=http://127.0.0.1:8000/v1
# AGENT_INTENT_MODEL=small-quantized
# AGENT_PLANNING_PROVIDER=openai
# AGENT_PLANNING_BASE_URL=http://127.0.0.1:8000/v1
# AGENT_PLANNING_MODEL=small-quantized
# AGENT_RECOVERY_PROVIDER=deterministic

# To route one stage to the fleet's authenticated cloud reasoning tool, set
# that stage's BASE_URL to this exact URL and provide its device credential.
# AGENT_CLOUD_ASSIST_URL=https://fleet.example/v1/assist
# AGENT_CLOUD_ASSIST_DEVICE_TOKEN=
# AGENT_CLOUD_ASSIST_CA=/path/to/fleet-ca.crt

# Optional independent registered-capability goal planner (inherits AGENT_*).
# AGENT_GOAL_PROVIDER=openai
# AGENT_GOAL_BASE_URL=http://127.0.0.1:8000/v1
# AGENT_GOAL_MODEL=small-quantized
# AGENT_GOAL_API_KEY=

# Optional commissioned pick/place action policy (independent of the LLM).
# Read from this file by Local Agent. Disabled by default; no bundled hardware model.
LOCAL_POLICY_MODE=disabled
# LOCAL_POLICY_MODE=http
# LOCAL_POLICY_ENDPOINT=http://127.0.0.1:8091
# LOCAL_POLICY_TIMEOUT=800ms
# LOCAL_POLICY_ROBOT_MODEL=commissioned-model-id
# LOCAL_POLICY_TRANSFORM_REVISION=commissioned-transform-revision
# LOCAL_POLICY_CALIBRATION_REVISION=commissioned-calibration-revision

# Optional direct model endpoint cache hints (default: omit hints).
# Requires AGENT_GOAL_PROVIDER=openai and the endpoint's corresponding support.
# No global cache fallback; set RECOVERY separately if needed.
# AGENT_GOAL_CACHE_MODE=vllm
# AGENT_GOAL_CACHE_NAMESPACE=site-a-robot-lab
# For a direct OpenAI endpoint use mode=openai. /v1/assist must use off.
# These hints do not authorize actions or prove a cache hit.

# Optional model accounting and planning recipes (off unless configured).
# The usage file parent must be owned by the agent user and not group/world writable.
# AGENT_MODEL_USAGE_FILE=/var/lib/tangying-agent/model-usage.jsonl
# AGENT_GOAL_OUTPUT_TOKENS=2048
# AGENT_RECOVERY_OUTPUT_TOKENS=1024
# Start with hint; validated rechecks exact proposals against fresh planning reads.
# AGENT_GOAL_RECIPE_MODE=hint
