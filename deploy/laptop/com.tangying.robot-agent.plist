<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>com.tangying.robot-agent</string>
  <key>ProgramArguments</key>
  <array>
    <string>/Users/Shared/TangyingRobotAgent/bin/local-agent</string>
    <string>--config</string><string>__HOME__/Library/Application Support/TangyingRobotAgent/local.env</string>
    <string>--data-dir</string><string>__HOME__/Library/Application Support/TangyingRobotAgent</string>
  </array>
  <key>RunAtLoad</key><true/>
  <key>KeepAlive</key><true/>
  <key>StandardOutPath</key><string>__HOME__/Library/Application Support/TangyingRobotAgent/logs/local-agent.log</string>
  <key>StandardErrorPath</key><string>__HOME__/Library/Application Support/TangyingRobotAgent/logs/local-agent.error.log</string>
</dict>
</plist>
