[Unit]
Description=Tangying Robot Edge gateway and safety supervisor
After=network-online.target tangying-xlerobot.service
Wants=network-online.target
Requires=tangying-xlerobot.service

[Service]
Type=simple
User=tangying-robot
Group=tangying-robot
SupplementaryGroups=dialout
EnvironmentFile=/etc/tangying-robot-agent-os/robot-pi.env
Environment=ROS_DOMAIN_ID=73
Environment=ROS_AUTOMATIC_DISCOVERY_RANGE=LOCALHOST
Environment=PYTHONPATH=/opt/tangying-robot-agent-os/python:/opt/tangying-robot-agent-os/robot/gateway:/opt/tangying-robot-agent-os/.venv/lib/python3.12/site-packages
ExecStart=/bin/bash -lc 'source /opt/ros/jazzy/setup.bash && source /opt/tangying-robot-agent-os/robot/ros2_ws/install/setup.bash && ros2 launch tangying_ros_gateway robot_edge.launch.py'
Restart=on-failure
RestartSec=1
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/var/lib/tangying-robot-agent-os

[Install]
WantedBy=multi-user.target

