ROBOT_GRPC_LISTEN=0.0.0.0:50051
ROBOT_SERVER_KEY=/var/lib/tangying-robot-agent-os/certs/server.key
ROBOT_SERVER_CERT=/var/lib/tangying-robot-agent-os/certs/server.crt
ROBOT_CLIENT_CA=/var/lib/tangying-robot-agent-os/certs/client-ca.crt
XLEROBOT_PORT1=/dev/tangying-left
XLEROBOT_PORT2=/dev/tangying-right
XLEROBOT_CALIBRATION=/var/lib/tangying-robot-agent-os/calibration
XLEROBOT_CALIBRATION_ROOT=/var/lib/tangying-robot-agent-os/calibration
XLEROBOT_UPSTREAM_ROOT=/opt/XLeRobot
XLEROBOT_MAX_RELATIVE_TARGET=8.0
XLEROBOT_MAX_ACTION_CHUNK_LENGTH=64
ROBOT_RUNTIME_JOURNAL=/var/lib/tangying-robot-agent-os/runtime-journal.json
# Never point the journal at /tmp, /run, a container layer, or a new file to
# bypass unresolved history. A missing file means uninitialized, not reconciled.
# Required by production-check after completing the offline Sim2Real kit.
# Keep the deployed env identical to the kit's robot-pi.env before recording.
# ROBOT_COMMISSIONING_KIT=/var/lib/tangying-robot-agent-os/commissioning
# Set a unique ROBOT_ID matching site.json; softwareRevision records the exact
# installed Git commit. Sensor freshness and stop response still need live checks.
# Optional direct-edge providers:
# ROBOT_ENTITY_PROVIDER=my_perception.providers:scene_entities
# ROBOT_VERIFIER_PROVIDER=my_perception.providers:verify
