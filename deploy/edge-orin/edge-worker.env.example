# Fleet mode for ONE robot on Orin NX. Do not run local-agent at the same time.
# Install as /etc/tangying-robot-agent-os/edge-worker.env (0640 root:service-group).
EDGE_ROBOT_ID=robot-7
EDGE_FLEET_URL=https://fleet.example
EDGE_DEVICE_TOKEN=replace-with-robot-7-device-token
EDGE_FLEET_CA=/etc/tangying/certs/fleet-https-ca.crt
EDGE_FLEET_GRPC=fleet.example:8444
EDGE_MTLS_CA=/etc/tangying/certs/fleet-grpc-ca.crt
EDGE_MTLS_CERT=/etc/tangying/certs/robot-7.crt
EDGE_MTLS_KEY=/etc/tangying/certs/robot-7.key
EDGE_MTLS_SERVER_NAME=fleet.example
EDGE_RUNTIME_ADDR=127.0.0.1:50051
EDGE_RUNTIME_CA=/etc/tangying/certs/robot-ca.crt
EDGE_RUNTIME_CERT=/etc/tangying/certs/agent.crt
EDGE_RUNTIME_KEY=/etc/tangying/certs/agent.key
EDGE_RUNTIME_SERVER_NAME=robot-7
EDGE_TASK_SOURCE=http
EDGE_WORLD_ID=fleet-default
EDGE_TELEMETRY_INTERVAL=2s
# Real hardware may only use a commissioned model/adapter-specific policy.
EDGE_POLICY_MODE=disabled
