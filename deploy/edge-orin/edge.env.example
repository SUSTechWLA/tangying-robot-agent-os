# Copy to a private file (0600 for the service user or 0640 root:service-group).
# Run one local-agent for
# exactly one robot; do not also run edge-worker against this Robot Runtime.
LOCAL_ROBOT_ID=robot-7
LOCAL_LISTEN=127.0.0.1:8787
ROBOT_ADDRESS=127.0.0.1:50051
ROBOT_SERVER_NAME=robot-7
ROBOT_CA=/etc/tangying/certs/robot-ca.crt
ROBOT_CERT=/etc/tangying/certs/agent.crt
ROBOT_KEY=/etc/tangying/certs/agent.key

AGENT_PROVIDER=deterministic
AGENT_INTENT_PROVIDER=openai
AGENT_INTENT_BASE_URL=http://127.0.0.1:8000/v1
AGENT_INTENT_MODEL=small-quantized
AGENT_PLANNING_PROVIDER=openai
AGENT_PLANNING_BASE_URL=http://127.0.0.1:8000/v1
AGENT_PLANNING_MODEL=small-quantized
AGENT_RECOVERY_PROVIDER=deterministic

# Optional cloud tool for complex planning: set PLANNING_BASE_URL to the URL
# below and PLANNING_MODEL=cloud-planning. The cloud chooses the real model.
# AGENT_CLOUD_ASSIST_URL=https://fleet.example/v1/assist
# AGENT_CLOUD_ASSIST_DEVICE_TOKEN=replace-with-robot-7-assist-only-token
# AGENT_CLOUD_ASSIST_CA=/etc/tangying/certs/fleet-ca.crt
