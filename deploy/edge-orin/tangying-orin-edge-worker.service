[Unit]
Description=Tangying Orin NX Fleet Edge Worker
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=tangying-robot
Group=tangying-robot
EnvironmentFile=/etc/tangying-robot-agent-os/edge-worker.env
Environment=ROBOT_CONTROL_LOCK_DIR=/var/lib/tangying-robot-agent-os
StateDirectory=tangying-robot-agent-os
StateDirectoryMode=0700
ExecStartPre=/usr/local/bin/tangying-edge-worker --check-config
ExecStart=/usr/local/bin/tangying-edge-worker
Restart=on-failure
RestartSec=3
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/var/lib/tangying-robot-agent-os

[Install]
WantedBy=multi-user.target
